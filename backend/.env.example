# =============================================================================
# BillAgent Pro - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=billagent
POSTGRES_USER=billagent
POSTGRES_PASSWORD=your_secure_password_here

# Async database URL (used by SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Sync database URL (used by Alembic migrations)
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Redis Configuration (Task Queue & Caching)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# -----------------------------------------------------------------------------
# OCR API Keys
# -----------------------------------------------------------------------------
# Mistral OCR API Key (Primary OCR Engine)
MISTRAL_API_KEY=WGY8MkPL379Q92uW0YM6zHpyA17hWVW0

# OpenAI API Key (Fallback OCR - GPT-4o Vision)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Optional - for insights generation)
GOOGLE_API_KEY=AIzaSyCtr7UeqJK35aS09ReMRtNiDNzBqRDz3J8

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (set to false in production)
DEBUG=true

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=BillAgent Pro

# CORS Origins (comma-separated, use * for development only)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your_super_secret_key_here_generate_with_openssl

# JWT Token expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
# Upload directory for bill images
UPLOAD_DIR=./uploads

# Maximum file size in MB
MAX_FILE_SIZE_MB=10
# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Max API requests per minute per client
RATE_LIMIT_PER_MINUTE=100

# Burst size for rate limiting
RATE_LIMIT_BURST_SIZE=20

# -----------------------------------------------------------------------------
# Error Monitoring (Sentry)
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=